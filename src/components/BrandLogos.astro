---
import { BRANDS } from "../lib/site";
/**
 * "Brands I've worked with" row. Logos are white-on-transparent PNGs in
 * /images/brands/ so the row looks uniform; brands without a logo show as a wordmark.
 */
---
<div class="logos rv">
  <span class="kicker">Brands I've worked with</span>
  <ul class="logos__row">
    {BRANDS.map((b) => (
      <li class="logos__slot">
        {b.logo ? <img src={b.logo} alt={b.name} loading="lazy" /> : <span class="logos__name">{b.name}</span>}
      </li>
    ))}
  </ul>
</div>
