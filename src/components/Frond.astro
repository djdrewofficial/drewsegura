---
/**
 * Palm frond silhouette, generated procedurally: leaflets are laid out
 * along a bent stem and angled toward the tip. Color comes from CSS
 * `color` (fill: currentColor), size/position/rotation from `class`.
 */
interface Props { class?: string; leaflets?: number; }
const { class: cls = "", leaflets = 24 } = Astro.props;

const P0 = [10, 110], P1 = [210, 40], P2 = [410, 120];
const at = (t: number, i: number) => (1 - t) ** 2 * P0[i] + 2 * (1 - t) * t * P1[i] + t * t * P2[i];
const slope = (t: number, i: number) => 2 * (1 - t) * (P1[i] - P0[i]) + 2 * t * (P2[i] - P1[i]);

const leaves: string[] = [];
for (let n = 1; n <= leaflets; n++) {
  const t = n / (leaflets + 1);
  const x = at(t, 0), y = at(t, 1);
  const base = (Math.atan2(slope(t, 1), slope(t, 0)) * 180) / Math.PI;
  const len = 40 + 120 * Math.sin(Math.PI * (0.18 + 0.72 * t)) * (1 - 0.55 * t);
  const w = Math.max(5, len * 0.11);
  const leaf = `M0 0 Q${(len * 0.45).toFixed(1)} ${(-w).toFixed(1)} ${len.toFixed(1)} 0 Q${(len * 0.45).toFixed(1)} ${w.toFixed(1)} 0 0Z`;
  for (const side of [-1, 1]) {
    const a = base + side * (48 + 10 * t) + 10;
    leaves.push(`<path transform="translate(${x.toFixed(1)} ${y.toFixed(1)}) rotate(${a.toFixed(1)})" d="${leaf}"/>`);
  }
}
const stem = `M${P0[0]} ${P0[1]} Q${P1[0]} ${P1[1]} ${P2[0]} ${P2[1]} L${P2[0]} ${P2[1] + 3} Q${P1[0]} ${P1[1] + 6} ${P0[0]} ${P0[1] + 6}Z`;
---
<svg class={`frond ${cls}`} viewBox="-60 -110 560 360" aria-hidden="true" focusable="false">
  <path d={stem} />
  <Fragment set:html={leaves.join("")} />
</svg>
