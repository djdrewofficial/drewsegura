---
import Brand from "../layouts/Brand.astro";
import PageHero from "../components/PageHero.astro";
import BookBand from "../components/BookBand.astro";
import Shot from "../components/Shot.astro";
import { icon } from "../lib/icons";

const chapters = [
  {
    no: "01", tag: "How it started",
    title: "A DJ Hero game and a 13-year-old who wouldn't put the controller down.",
    img: "/images/story-13.jpg", alt: "Teenage Drew in glasses and a snapback in front of his homemade DJ DREW sign", ratio: "2 / 1", cap: "DJ Drew, the early years",
    body: [
      "I started DJing when I was 13 after getting DJ Hero for my birthday. At first it was just something fun, but I got into it pretty quickly.",
      "Not long after that I got my first DJ controller and started teaching myself how to mix. I would spend hours practicing, learning transitions, and figuring out how to actually move a crowd before I ever played in front of one.",
    ],
    names: ["DJ Hero", "Age 13", "Self-taught"],
  },
  {
    no: "02", tag: "The creator before the club",
    title: "I learned to read a room through a screen, to thousands of people at once.",
    img: "/images/story-live.jpg", alt: "Drew on the Xpress podcast set with a guest", ratio: "4 / 3", cap: "Still on camera",
    body: [
      "Eventually I started live streaming on a platform called YouNow. That's where things started to shift for me. I built a following and became one of the top creators on there for a while, which gave me real experience playing for people, even if it was through a screen.",
      "That's still a big part of who I am. I'm as comfortable talking to a camera as I am talking to a dance floor, and I bring both to every event.",
      "Streaming led to my first real opportunity: DJing private events at a banquet hall in Pompano Beach, where I learned what it actually takes to keep a live crowd going.",
    ],
    names: ["YouNow", "Pompano Beach"],
  },
  {
    no: "03", tag: "The nightlife years",
    title: "Las Olas at 18. No setlist, no safety net, just reading the energy.",
    img: "/images/story-nightlife.jpg", alt: "Drew smiling behind the decks at Hunters Nightclub", ratio: "1 / 1", cap: "Hunters · Wilton Manors",
    body: [
      "I got into nightlife when I was 18, DJing on Las Olas at places like Vibe Las Olas and American Social alongside my good friend and mentor Frankie P. That's where I really learned how to read a crowd in real time: no set playlists, no structure, just reacting to the energy and keeping people moving.",
      "From there I started DJing at LGBTQ+ venues across the country, including The Manor, Scorpio, Rumors, Johnsons and Leboy. Now my main residency is Hunters Nightclub in Wilton Manors, where I play every week.",
      "Nightlife pushed me to become a better DJ. It taught me timing, crowd control, and how to keep the energy up all night, and I bring that energy into every event.",
    ],
    names: ["Vibe Las Olas", "American Social", "The Manor", "Scorpio", "Hunters"],
  },
  {
    no: "04", tag: "Building Xpress",
    title: "In 2016 I bet on myself. It grew into a whole team.",
    img: "/images/story-xpress.jpg", alt: "Drew on the mic walking across a monogrammed wedding dance floor", ratio: "4 / 5", cap: "Running the floor",
    body: [
      "In 2016 I started Xpress DJs. At the time it was just me trying to take things more seriously and turn what I loved into something real. I was doing smaller events and learning as I went: how to work with clients, how to run a timeline, and how to actually create an experience, not just play music.",
      "Over time things grew. More bookings, better events, bigger opportunities. I started building a team, bringing in other DJs, and turning it into something bigger than myself.",
      "Now Xpress Entertainment performs at 150+ weddings a year across South Florida, with a reputation for real energy and packed dance floors.",
    ],
    names: ["Xpress Entertainment", "Est. 2016", "150+ weddings a year"],
  },
];

const values = [
  { icon: "globe", t: "Bilingual by nature", d: "Raised Dominican-American, fluent in English and Spanish. Everyone in the room gets it in their own language." },
  { icon: "users", t: "I read, I don't recite", d: "Years of nightlife with no setlist taught me to play to the actual crowd in front of me, not a pre-baked playlist." },
  { icon: "music", t: "Genre has no borders", d: "Reggaetón into 2000s hip-hop into salsa into house. Open-format mixing that keeps every generation moving." },
  { icon: "cam", t: "Built for the camera too", d: "I started as a creator. I know how to make a moment look as good on a phone as it feels in the room." },
];

const personLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: {
    "@type": "Person",
    name: "Drew Segura",
    alternateName: ["DJ Drew Segura", "El Gringo Dominicano"],
    jobTitle: "DJ, MC & Content Creator",
    knowsLanguage: ["en", "es"],
    worksFor: { "@type": "Organization", name: "Xpress Entertainment", url: "https://xpressdjs.com" },
  },
};
---
<Brand
  title="About Drew Segura | El Gringo Dominicano | DJ, MC & Content Creator"
  description="The story of DJ Drew Segura, El Gringo Dominicano: from DJ Hero at 13 and YouNow live streams to Las Olas nightlife, a weekly Hunters residency, and founding Xpress Entertainment."
>
  <PageHero
    kicker="Mi historia"
    title="The whole<br/>story."
    script="El Gringo Dominicano"
    lead="Dominican-American, raised on merengue and hip-hop, and doing this since I was thirteen. Here's how a bedroom hobby turned into clubs, brands, cameras and 150+ weddings a year."
    img="/images/portrait-suit.jpg"
    imgAlt="Drew Segura smiling in a black suit and tie"
    imgPos="50% 18%"
  >
    <div class="phero__stats">
      <span><b>15+</b> years</span><span><b>1,000+</b> events</span><span><b>EN/ES</b> on the mic</span>
    </div>
  </PageHero>

  <section class="section section--light">
    <div class="wrap">
      {chapters.map((c, i) => (
        <article class={`story ${i % 2 ? "story--flip" : ""}`}>
          <div class="story__media rv">
            <Shot ratio={c.ratio} src={c.img} label={c.alt} />
            <span class="story__cap">{c.cap}</span>
          </div>
          <div class="story__text rv">
            <span class="story__no">{c.no}</span>
            <span class="kicker">{c.tag}</span>
            <h2>{c.title}</h2>
            {c.body.map((p, j) => <p class={j === 0 ? "lead" : ""}>{p}</p>)}
            <div class="tags">{c.names.map((n) => <span>{n}</span>)}</div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section brands">
    <div class="wrap">
      <div class="sec-head rv">
        <span class="kicker">What all of that means for you</span>
        <h2 class="display h2">Why people <span class="script" style="color:var(--pink)">book me</span></h2>
      </div>
      <div class="offer">
        {values.map((v) => (
          <article class="offer__card rv">
            <div class="offer__icon"><Fragment set:html={icon(v.icon)} /></div>
            <h3>{v.t}</h3>
            <p>{v.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--pink gallery-sec">
    <div class="wrap">
      <div class="sec-head rv"><span class="kicker">More of me</span></div>
      <div class="gallery">
        <Shot ratio="3 / 2" src="/images/portrait-tee.jpg" label="Drew in a black tee and chain, looking off camera" class="g-wide rv" />
        <Shot ratio="3 / 4" src="/images/nightlife-booth.jpg" label="Drew in the booth before a club set" class="rv" />
        <Shot ratio="3 / 4" src="/images/wedding-booth.jpg" label="Drew smiling behind the decks at a wedding" class="rv" />
        <Shot ratio="3 / 4" src="/images/reel-outdoor.jpg" label="Drew laughing behind the decks at an outdoor night event" class="rv" />
        <Shot ratio="3 / 4" src="/images/reel-podcast.jpg" label="Drew on the Xpress podcast set" class="rv" />
        <Shot ratio="3 / 2" src="/images/portrait-jacket.jpg" label="Drew in a black suit, adjusting his jacket" class="g-wide rv" />
      </div>
    </div>
  </section>

  <BookBand />
  <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
</Brand>
