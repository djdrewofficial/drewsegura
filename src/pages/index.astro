---
import Brand from "../layouts/Brand.astro";
import Frond from "../components/Frond.astro";
import Shot from "../components/Shot.astro";
import BrandLogos from "../components/BrandLogos.astro";
import LeadForm from "../components/LeadForm.astro";
import ReelGrid from "../components/ReelGrid.astro";
import { CONTACT, SOCIALS, NIGHT_VENUES } from "../lib/site";
import { icon as I } from "../lib/icons";

const TICKER = ["DJ", "MC", "Content Creator", "Host", "English", "Español", "Miami", "Fort Lauderdale", "Everywhere"];

const CHAPTERS = [
  { yr: "13", h: "DJ Hero for my birthday.", p: "A video game turned into my first controller, and I taught myself to mix in my bedroom for hours a day." },
  { yr: "LIVE", h: "One of the top creators on YouNow.", p: "Live-streaming sets to thousands taught me to hold an audience through a camera before I ever had a dance floor." },
  { yr: "18", h: "Las Olas nightlife.", p: "Vibe Las Olas and American Social with my mentor Frankie P. No setlist, no safety net, just reading the room." },
  { yr: "2016", h: "Started Xpress DJs.", p: "It was just me. Now Xpress Entertainment is a full team playing 150+ weddings a year across South Florida." },
];

const OFFER = [
  { icon: "mic", h: "MC & Host", p: "I host launches, activations, festivals and stages in English and Spanish. I keep the energy up, the run of show on time, and your message landing." },
  { icon: "decks", h: "DJ Sets", p: "Open-format sets built around your brand and your crowd, from reggaetón to house to throwbacks. It sounds like your brand, not a random playlist." },
  { icon: "cam", h: "Content", p: "I capture the moment while it's happening: reels, TikToks and behind-the-scenes from your event, posted to people who already follow me." },
  { icon: "bolt", h: "The Full Package", p: "DJ, MC and content creator in one booking. One person runs the room and makes sure the internet sees it." },
];

const USECASES = ["Brand activations", "Product launches", "Pop-ups", "Store openings", "Festivals", "Corporate events", "Sports & halftime", "Galas", "Social campaigns"];

---
<Brand>
  <!-- ================= HERO ================= -->
  <section class="hero">
    <Frond class="f1 sway" />
    <Frond class="f2 sway sway--slow" />
    <Frond class="f3 sway" leaflets={18} />
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <span class="kicker hero__kicker">DJ · MC · Content Creator</span>
        <h1 class="display">DJ Drew<br /><span class="outline">Segura</span></h1>
        <p class="hero__persona script">El Gringo Dominicano</p>
        <div class="hero__roles">
          <a class="chip chip--solid" href="/brands">Brands & Activations</a>
          <a class="chip" href="/nightlife">Nightlife</a>
          <a class="chip" href="/weddings">Weddings</a>
        </div>
        <p class="hero__lead">
          I'm the guy you book when the room has to feel it. I DJ, I run the mic, and I make content
          people actually watch, in English <em>y en español.</em>
        </p>
        <div class="hero__ctas">
          <a class="btn btn--dark" href="/book?type=brand">Book me for your brand <Fragment set:html={I("arrow")} /></a>
          <a class="btn btn--ghost" href="/about">Meet the Gringo</a>
        </div>
      </div>
      <div class="hero__photo">
        <div class="hero__sticker">15+ yrs<small>on the mic</small></div>
        <div class="hero__frame">
          <img src="/images/hero-drew.jpg" alt="DJ Drew Segura in a black suit, arms crossed" width="1024" height="1536" fetchpriority="high" />
        </div>
      </div>
    </div>
  </section>

  <!-- ================= TICKER ================= -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {[0, 1].map(() => (
        <div class="marquee__group">
          {TICKER.map((t) => (<><span>{t}</span><span class="star">✦</span></>))}
          <span class="es">¿Qué lo que?</span><span class="star">✦</span>
        </div>
      ))}
    </div>
  </div>

  <!-- ================= ABOUT ================= -->
  <section class="section section--light" id="about">
    <div class="wrap">
      <div class="about__intro">
        <div class="about__portrait rv">
          <Shot ratio="4 / 5" src="/images/about-drew.jpg" label="Drew in a suit with DJ headphones on" />
          <div class="about__tag">100% <b>Dominicano</b>, 100% gringo</div>
        </div>
        <div class="about__text rv">
          <span class="kicker" style="color:var(--pink-deep)">¿Quién es?</span>
          <h2 class="display">Who's the Gringo<span class="script">Dominicano?</span></h2>
          <p class="lead">
            People look at me and assume I'm the gringo at the party. Then I grab the mic and switch to Spanish
            mid-sentence, and the tías in the back start screaming. <strong>That's the whole point of me.</strong>
          </p>
          <p>
            I grew up Dominican-American, going back and forth between English and Spanish, between merengue at
            family parties and hip-hop in the car. I don't have to pick a side. On the mic that means everyone in
            the room is in on it, whether that's your abuela, your clients, or a crowd of strangers at a
            brand pop-up.
          </p>
          <p>
            I've been doing this since I was thirteen: bedroom mixes, live streams, Las Olas clubs, residencies
            around the country, and more than a thousand events. Every one of those rooms taught me the same
            thing: read the people in front of you and never let the energy drop.
          </p>
          <div class="flags">
            <svg viewBox="0 0 34 22" aria-label="Dominican Republic flag" role="img"><rect width="34" height="22" fill="#fff"/><rect width="14" height="8.5" fill="#002d62"/><rect x="20" width="14" height="8.5" fill="#ce1126"/><rect y="13.5" width="14" height="8.5" fill="#ce1126"/><rect x="20" y="13.5" width="14" height="8.5" fill="#002d62"/></svg>
            <span>+</span>
            <svg viewBox="0 0 34 22" aria-label="United States flag" role="img"><rect width="34" height="22" fill="#b22234"/>{[1,3,5,7,9,11].map((i) => <rect y={i * 1.7} width="34" height="1.7" fill="#fff" />)}<rect width="15" height="11.9" fill="#3c3b6e"/></svg>
            <span>Raised on both</span>
          </div>
        </div>
      </div>

      <div class="stats rv">
        <div class="stat"><b>15+</b><span>years behind the decks</span></div>
        <div class="stat"><b>1,000+</b><span>events played</span></div>
        <div class="stat"><b>EN/ES</b><span>bilingual on the mic</span></div>
        <div class="stat"><b>Weekly</b><span>residency at Hunters</span></div>
      </div>

      <div class="sec-head rv" style="margin-bottom:28px">
        <span class="kicker">The short version</span>
      </div>
      <div class="timeline">
        {CHAPTERS.map((c) => (
          <article class="chapter rv">
            <span class="chapter__yr">{c.yr}</span>
            <h3>{c.h}</h3>
            <p>{c.p}</p>
          </article>
        ))}
      </div>
      <div class="about__more rv">
        <a class="btn btn--dark" href="/about">Read my whole story <Fragment set:html={I("arrow")} /></a>
      </div>
    </div>
  </section>

  <!-- ================= BRANDS ================= -->
  <section class="section brands" id="brands">
    <Frond class="f-brand" />
    <div class="wrap">
      <div class="brands__head rv">
        <div>
          <span class="kicker" style="color:var(--pink)">For brands, agencies & activations</span>
          <h2 class="display h2" style="margin-top:16px">Your brand.<br /><span class="pink">My mic.</span><br />Everybody's watching.</h2>
        </div>
        <p class="lead">
          You need more than background music at an activation. You need someone who pulls people in, keeps them
          there, and makes them post about it. I've been doing that on stages, in clubs and on camera since I was a
          kid, and I do it in two languages.
        </p>
      </div>

      <div class="offer">
        {OFFER.map((o) => (
          <article class="offer__card rv">
            <div class="offer__icon"><Fragment set:html={I(o.icon)} /></div>
            <h3>{o.h}</h3>
            <p>{o.p}</p>
          </article>
        ))}
      </div>

      <div class="usecases rv">
        {USECASES.map((u) => <span>{u}</span>)}
      </div>

      <BrandLogos />

      <div class="brands__cta rv">
        <a class="btn btn--pink" href="/brands">How I work with brands <Fragment set:html={I("arrow")} /></a>
        <a class="btn btn--ghost" href="/book?type=brand">Get a quote</a>
      </div>
    </div>
  </section>

  <!-- ================= WEDDINGS + NIGHTLIFE ================= -->
  <div class="stages">
    <section class="stage stage--wed" id="weddings">
      <div class="rv">
        <span class="kicker">Weddings</span>
        <h2 class="display">Your wedding<span class="script">la fiesta de tu vida</span></h2>
        <p class="lead">
          Weddings are where I built my name. I started Xpress Entertainment in 2016, and our team now plays
          150+ weddings a year across South Florida.
        </p>
        <Shot ratio="16 / 10" src="/images/wedding-mic.jpg" label="Drew on the mic at a garden wedding" class="pos-top" />
        <ul>
          <li>Bilingual MC, so both sides of the family are in on every moment</li>
          <li>Reggaetón, salsa, merengue, 2000s hip-hop, house: one floor, every generation</li>
          <li>Ceremony, cocktail hour and reception run as one night</li>
        </ul>
        <a class="btn btn--dark" href="/weddings">Plan your wedding with me <Fragment set:html={I("arrow")} /></a>
      </div>
    </section>

    <section class="stage stage--night" id="nightlife">
      <Frond class="f-night" />
      <div class="rv">
        <span class="kicker">Nightlife</span>
        <h2 class="display">After dark<span class="script">hasta que salga el sol</span></h2>
        <p class="lead">
          I started in clubs on Las Olas at 18. Since then I've played LGBTQ+ venues across the country, and I
          hold a weekly residency at Hunters Nightclub in Wilton Manors.
        </p>
        <Shot ratio="16 / 10" src="/images/nightlife-hunters.jpg" label="Drew on the decks at Hunters Nightclub, Wilton Manors" class="pos-top" />
        <div class="venues">
          <span class="res">Resident · Hunters, Wilton Manors</span>
          {NIGHT_VENUES.map((v) => <span>{v}</span>)}
        </div>
        <a class="btn btn--pink" href="/nightlife">Nightlife & residencies <Fragment set:html={I("arrow")} /></a>
      </div>
    </section>
  </div>

  <!-- ================= CONTENT ================= -->
  <section class="section section--pink" id="content">
    <div class="wrap">
      <div class="content__head rv">
        <div class="sec-head" style="margin:0">
          <span class="kicker">Content creator</span>
          <h2 class="display h2">Follow<br />the <span class="script">vibe</span></h2>
        </div>
        <div class="socials">
          {SOCIALS.map((s) => (
            <a class="social" href={s.href} target="_blank" rel="noopener">
              <Fragment set:html={I(s.icon)} />{s.handle}
            </a>
          ))}
        </div>
      </div>
      <ReelGrid />
      <div class="rv" style="margin-top:44px"><a class="btn btn--dark" href="/mixes">Listen to my mixes <Fragment set:html={I("arrow")} /></a></div>
    </div>
  </section>

  <!-- ================= BOOK ================= -->
  <section class="section book" id="book">
    <Frond class="f-book1 sway sway--slow" />
    <Frond class="f-book2" />
    <div class="wrap book__grid">
      <div class="rv">
        <h2 class="display"><span class="script">¿Qué lo que?</span>Let's work.</h2>
        <p class="lead" style="margin-top:24px; color:rgba(255,246,250,.82)">
          Tell me what you're planning: an activation, a launch, your club night, or your wedding.
          I answer personally, usually the same day.
        </p>
        <div class="book__direct">
          <a href={`sms:${CONTACT.phoneSms}`}><Fragment set:html={I("chat")} />Text me · {CONTACT.phoneDisplay}</a>
          <a href={`tel:${CONTACT.phoneDial}`}><Fragment set:html={I("phone")} />Call · {CONTACT.phoneDisplay}</a>
          <a href={`mailto:${CONTACT.email}`}><Fragment set:html={I("mail")} />{CONTACT.email}</a>
        </div>
      </div>
      <div class="rv"><LeadForm /></div>
    </div>
  </section>
</Brand>
