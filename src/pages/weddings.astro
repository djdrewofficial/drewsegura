---
import Brand from "../layouts/Brand.astro";
import PageHero from "../components/PageHero.astro";
import BookBand from "../components/BookBand.astro";
import Faq from "../components/Faq.astro";
import Shot from "../components/Shot.astro";
import { WEDDING_FAQS, GENRES, CONTACT } from "../lib/site";
import { icon } from "../lib/icons";

const included = [
  { icon: "heart", h: "Ceremony sound", p: "Wireless mics so your vows are actually heard, and the right song cued the second those doors open." },
  { icon: "music", h: "Cocktail hour", p: "Easy open-format while everyone finds the bar and their seat. I'm quietly setting the temperature for the night." },
  { icon: "spark", h: "The grand entrance", p: "I announce you like you're headlining the building. You walk in to your song and the party has a heartbeat." },
  { icon: "decks", h: "The dance floor", p: "Reggaetón into 2000s hip-hop into the salsa your tía screams for, without ever clearing the floor." },
  { icon: "globe", h: "Bilingual MC", p: "I run the whole night in English and Spanish, so both sides of the family feel every moment." },
  { icon: "bolt", h: "The extras", p: "Uplighting in your colors, monograms, cold sparks, dancing on the clouds, photo booths. Add what you love, skip the rest." },
];
---
<Brand
  title="Bilingual Wedding DJ & MC in Miami & Fort Lauderdale | DJ Drew Segura"
  description="Bilingual (English/Spanish) wedding DJ and MC Drew Segura keeps South Florida dance floors packed: ceremony, cocktail hour and reception, backed by Xpress Entertainment's 150+ weddings a year."
>
  <PageHero
    kicker="Weddings · Bodas"
    title="Your wedding.<br/>Your people."
    script="la fiesta de tu vida"
    lead="A bilingual DJ and MC who gets your abuela and your college friends on the same dance floor. Ceremony to last call, in English y en español."
    img="/images/wedding-booth.jpg"
    imgAlt="Drew smiling behind his DJ setup at a wedding"
    imgPos="50% 40%"
  >
    <div class="phero__ctas">
      <a class="btn btn--dark" href="/book?type=wedding">Check my availability <Fragment set:html={icon("arrow")} /></a>
      <a class="btn btn--ghost" href="#faq">Wedding FAQ</a>
    </div>
  </PageHero>

  <section class="section section--light">
    <div class="wrap">
      <div class="sec-head rv">
        <span class="kicker">What's included</span>
        <h2 class="display h2">One night.<br /><span class="script">every moment.</span></h2>
      </div>
      <div class="incl">
        {included.map((x) => (
          <article class="incl__item rv">
            <div class="offer__icon"><Fragment set:html={icon(x.icon)} /></div>
            <div><h3>{x.h}</h3><p>{x.p}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section brands">
    <div class="wrap split">
      <div class="rv">
        <Shot ratio="4 / 5" src="/images/story-xpress.jpg" label="Drew on the mic walking across a monogrammed wedding dance floor" class="split__img" />
      </div>
      <div class="rv">
        <span class="kicker" style="color:var(--pink)">One floor, every generation</span>
        <h2 class="display h2" style="margin:14px 0 24px">I read<br />the room.</h2>
        <p class="lead" style="color:rgba(255,246,250,.85)">
          Your must-plays and your do-not-play list are yours. From there I watch the floor and move with it.
          Fifteen years of club nights taught me how to keep everybody up, from the tíos to the bridal party.
        </p>
        <div class="genres">{GENRES.map((g) => <span>{g}</span>)}</div>
      </div>
    </div>
  </section>

  <section class="section section--pink">
    <div class="wrap split">
      <div class="rv">
        <span class="kicker" style="color:var(--blanco)">A solo artist with a full crew</span>
        <h2 class="display h2" style="margin:14px 0 24px">Backed by<br />Xpress.</h2>
        <p class="lead">
          I DJ your wedding personally. Behind me is Xpress Entertainment, the company I started in 2016, which now
          plays 150+ weddings a year across South Florida. That means backup gear, planning tools, lighting and photo
          booths, and a team that has done this a lot.
        </p>
        <a class="btn btn--dark" href={CONTACT.companyUrl} target="_blank" rel="noopener">Visit Xpress Entertainment <Fragment set:html={icon("arrow")} /></a>
      </div>
      <div class="rv">
        <Shot ratio="3 / 2" src="/images/wedding-couple.jpg" label="Drew with a bride and groom at their wedding" class="split__img" />
      </div>
    </div>
  </section>

  <section class="section section--light">
    <div class="wrap faq-wrap">
      <div class="sec-head rv">
        <span class="kicker">Questions</span>
        <h2 class="display h2">Wedding <span class="script">FAQ</span></h2>
      </div>
      <Faq items={WEDDING_FAQS} />
    </div>
  </section>

  <BookBand title="Is your date open?" script="¡Felicidades!" text="Send me your date and venue. I'll check my calendar and send back real numbers." type="wedding" />
</Brand>
