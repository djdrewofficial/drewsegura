---
import Brand from "../layouts/Brand.astro";
import PageHero from "../components/PageHero.astro";
import { icon } from "../lib/icons";
---
<Brand title="Page not found | DJ Drew Segura" description="This page doesn't exist.">
  <PageHero
    kicker="404"
    title="Wrong<br/>room."
    script="¿Y tú qué haces aquí?"
    lead="This page doesn't exist, but the party's still going. Let's get you back on the floor."
  >
    <div class="phero__ctas">
      <a class="btn btn--dark" href="/">Back home <Fragment set:html={icon("arrow")} /></a>
      <a class="btn btn--ghost" href="/book">Book Drew</a>
    </div>
  </PageHero>
</Brand>
